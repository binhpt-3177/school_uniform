NODE_ENV=development
PORT=3000

# Primary database
DB_HOST=mysql
DB_PORT=3306
DB_USER=app
DB_PASSWORD=apppass
DB_NAME=app

# Integration test database (mysql_test service)
TEST_DB_HOST=mysql_test
TEST_DB_PORT=3306
TEST_DB_USER=app
TEST_DB_PASSWORD=apppass
TEST_DB_NAME=app_test

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookie / CORS
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:5000

# Misc
SWAGGER_ENABLED=true
LOG_LEVEL=debug
DEFAULT_LOCALE=vi
