{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS 11 API — base architecture",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "sh scripts/no-synchronize-true.sh && eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:unit": "jest --config jest.config.js",
    "test:int": "DB_HOST=$TEST_DB_HOST DB_PORT=$TEST_DB_PORT DB_USER=$TEST_DB_USER DB_PASSWORD=$TEST_DB_PASSWORD DB_NAME=$TEST_DB_NAME jest --config jest.int.config.js --runInBand",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:cov:int": "jest --config jest.int.config.js --runInBand --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/data-source-cli.ts migration:run",
    "migration:generate": "typeorm-ts-node-commonjs -d src/database/data-source-cli.ts migration:generate",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source-cli.ts migration:revert",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:show": "typeorm-ts-node-commonjs -d src/database/data-source-cli.ts migration:show",
    "console": "ts-node -r tsconfig-paths/register src/console.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "argon2": "^0.40.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "helmet": "^8.0.0",
    "joi": "^17.13.0",
    "mysql2": "^3.11.0",
    "nest-winston": "^1.10.0",
    "nestjs-command": "^3.1.4",
    "nestjs-i18n": "^10.5.0",
    "nestjs-pino": "^4.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.0"
  }
}
